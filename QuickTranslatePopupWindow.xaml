<Window x:Class="TaskbarInfo.QuickTranslatePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="420"
        Height="294"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        AllowsTransparency="False"
        Background="Transparent"
        Opacity="0"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="IconSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource ThemeMenuHoverBrush}" />
                                <Setter TargetName="IconSurface" Property="BorderBrush" Value="{DynamicResource ThemeMenuBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="#3C82E6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="RootCard"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Padding="17,16"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PopupTranslation" Y="8" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="18" />
                <RowDefinition Height="78" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition x:Name="DomainLeadingGap" Width="0" />
                    <ColumnDefinition x:Name="DomainColumn" Width="0" />
                    <ColumnDefinition x:Name="DomainTrailingGap" Width="0" />
                    <ColumnDefinition x:Name="AddDomainColumn" Width="0" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProviderBox"
                          MinWidth="112"
                          MaxDropDownHeight="240"
                          SelectionChanged="ProviderBox_SelectionChanged" />
                <ComboBox x:Name="TargetLanguageBox"
                          Grid.Column="2"
                          MaxDropDownHeight="240"
                          SelectionChanged="TargetLanguageBox_SelectionChanged">
                    <ComboBoxItem Tag="zh-CN" Content="译为中文" />
                    <ComboBoxItem Tag="en" Content="译为英文" />
                    <ComboBoxItem Tag="ja" Content="译为日文" />
                    <ComboBoxItem Tag="ko" Content="译为韩文" />
                </ComboBox>
                <ComboBox x:Name="DomainBox"
                          Grid.Column="4"
                          MaxDropDownHeight="240"
                          ToolTip="选择翻译领域"
                          Visibility="Collapsed"
                          SelectionChanged="DomainBox_SelectionChanged" />
                <ui:Button x:Name="AddDomainButton"
                        Grid.Column="6"
                        Appearance="Secondary"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTip="添加自定义领域"
                        Visibility="Collapsed"
                        Click="AddDomainButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ToggleButton x:Name="AlwaysOnTopButton"
                              Grid.Column="8"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTip="置顶窗口"
                              Checked="AlwaysOnTopButton_Checked"
                              Unchecked="AlwaysOnTopButton_Unchecked">
                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                </ToggleButton>
            </Grid>

            <TextBlock Grid.Row="2" Text="输入内容" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" />
            <ui:TextBox x:Name="InputTextBox"
                     Grid.Row="3"
                     PlaceholderText="输入需要翻译的文本，按 Ctrl+Enter 翻译"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     ToolTip="输入要翻译的文本，按 Ctrl+Enter 翻译"
                     KeyDown="InputTextBox_KeyDown" />

            <ui:InfoBar x:Name="StatusPanel"
                        Grid.Row="5"
                        Severity="Error"
                        IsClosable="False"
                        IsOpen="False"
                        Visibility="Collapsed" />

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="ProgressPanel"
                      Grid.Column="0"
                      Visibility="Collapsed"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing x:Name="TranslationProgressRing"
                                     Width="18"
                                     Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True" />
                    <TextBlock x:Name="ProgressText"
                               Grid.Column="1"
                               Margin="8,0"
                               Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="ResultLabel"
                           Grid.Column="0"
                           Text="译文"
                           Foreground="{DynamicResource ThemePrimaryTextBrush}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <ui:Button x:Name="TranslateButton"
                        Grid.Column="1"
                        Appearance="Primary"
                        Background="#FF0F6CBD"
                        Foreground="White"
                        BorderBrush="#FF0F6CBD"
                        MouseOverBackground="#FF479EF5"
                        MouseOverBorderBrush="#FF479EF5"
                        PressedBackground="#FF005FB8"
                        PressedBorderBrush="#FF005FB8"
                        PressedForeground="White"
                        MinWidth="76"
                        Height="32"
                        Padding="16,0"
                        Content="翻译"
                        Click="Translate_Click" />
            </Grid>

            <ui:TextBox x:Name="ResultTextBox"
                     Grid.Row="9"
                     PlaceholderText="翻译结果会显示在这里"
                     Height="64"
                     MinHeight="64"
                     MaxHeight="156"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     ToolTip="翻译结果" />
        </Grid>
    </Border>
</Window>
