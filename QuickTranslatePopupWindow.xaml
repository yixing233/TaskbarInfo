<Window x:Class="TaskbarInfo.QuickTranslatePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="294"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        AllowsTransparency="False"
        Background="Transparent"
        Opacity="0"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Window.Resources>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#4CFFFFFF" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#3A101923" />
        <SolidColorBrush x:Key="FocusedBorderBrush" Color="#95A9CEFF" />

        <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="Watermark"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Top"
                                           IsHitTestVisible="False"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#92C3D0E0"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource FocusedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InputSurface" Property="Background" Value="#2D0D1721" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F3F7FF" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#356EA6E8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#4C4D88D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="Foreground" Value="#F3F7FF" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GlassComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboSurface"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="6">
                                            <Grid>
                                                <TextBlock Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#F3F7FF"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Margin="0,0,10,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           Foreground="#BFDBF6" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#78FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource FocusedBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,5,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#F0182432"
                                        BorderBrush="#6BFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer CanContentScroll="True" MaxHeight="220">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#DDEBFF" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="IconSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="#4CFFFFFF" />
                                <Setter TargetName="IconSurface" Property="BorderBrush" Value="#78FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="#3C82E6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#DDEBFF" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="#4CFFFFFF" />
                                <Setter TargetName="IconSurface" Property="BorderBrush" Value="#78FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="#356EA6E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TranslateButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#357FD8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#4C92E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1E68C8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Padding="18,16"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PopupTranslation" Y="8" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="18" />
                <RowDefinition Height="78" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition x:Name="DomainLeadingGap" Width="0" />
                    <ColumnDefinition x:Name="DomainColumn" Width="0" />
                    <ColumnDefinition x:Name="DomainTrailingGap" Width="0" />
                    <ColumnDefinition x:Name="AddDomainColumn" Width="0" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProviderBox"
                          Style="{StaticResource GlassComboBoxStyle}"
                          SelectionChanged="ProviderBox_SelectionChanged" />
                <ComboBox x:Name="TargetLanguageBox"
                          Grid.Column="2"
                          Style="{StaticResource GlassComboBoxStyle}"
                          SelectionChanged="TargetLanguageBox_SelectionChanged">
                    <ComboBoxItem Tag="zh-CN" Content="译为中文" />
                    <ComboBoxItem Tag="en" Content="译为英文" />
                    <ComboBoxItem Tag="ja" Content="译为日文" />
                    <ComboBoxItem Tag="ko" Content="译为韩文" />
                </ComboBox>
                <ComboBox x:Name="DomainBox"
                          Grid.Column="4"
                          Style="{StaticResource GlassComboBoxStyle}"
                          ToolTip="选择翻译领域"
                          Visibility="Collapsed"
                          SelectionChanged="DomainBox_SelectionChanged" />
                <Button x:Name="AddDomainButton"
                        Grid.Column="6"
                        Style="{StaticResource IconActionButtonStyle}"
                        ToolTip="添加自定义领域"
                        Visibility="Collapsed"
                        Click="AddDomainButton_Click">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
                <ToggleButton x:Name="AlwaysOnTopButton"
                              Grid.Column="8"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTip="置顶窗口"
                              Checked="AlwaysOnTopButton_Checked"
                              Unchecked="AlwaysOnTopButton_Unchecked">
                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                </ToggleButton>
            </Grid>

            <TextBlock Grid.Row="2" Text="输入内容" Foreground="#DCE6F5" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="InputTextBox"
                     Grid.Row="3"
                     Style="{StaticResource GlassTextBoxStyle}"
                     Tag="输入需要翻译的文本，按 Ctrl+Enter 翻译"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     ToolTip="输入要翻译的文本，按 Ctrl+Enter 翻译"
                     KeyDown="InputTextBox_KeyDown" />

            <Grid x:Name="ProgressPanel"
                      Grid.Row="7"
                      Grid.Column="0"
                      Visibility="Collapsed"
                      VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Width="34"
                                 Height="3"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Foreground="#9DCCFF" />
                    <TextBlock x:Name="ProgressText"
                               Grid.Column="1"
                               Margin="8,0"
                               Foreground="#EEF6FF"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Border x:Name="StatusPanel"
                    Grid.Row="5"
                    Background="#35E74856"
                    BorderBrush="#8CE74856"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Foreground="#FFFFD8DC" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultLabel"
                           Text="译文"
                           Foreground="#DCE6F5"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <Button x:Name="TranslateButton"
                        Grid.Column="1"
                        Style="{StaticResource TranslateButtonStyle}"
                        Content="翻译"
                        Click="Translate_Click" />
            </Grid>

            <TextBox x:Name="ResultTextBox"
                     Grid.Row="9"
                     Style="{StaticResource GlassTextBoxStyle}"
                     Tag="翻译结果会显示在这里"
                     Height="64"
                     MinHeight="64"
                     MaxHeight="156"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     ToolTip="翻译结果" />
        </Grid>
    </Border>
</Window>
