<Window x:Class="TaskbarInfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskbarInfo"
        mc:Ignorable="d"
        Title="LyricsX" Height="30" Width="200"
        WindowStyle="None" ResizeMode="NoResize" 
        Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Window.Resources>
        <FontFamily x:Key="FontAwesome">./Fonts/fa-solid-900.ttf#Font Awesome 6 Free Solid</FontFamily>

        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FontAwesome}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBorder" Background="#33000000" CornerRadius="5" Padding="5,0">
            <Border.ToolTip>
                <ToolTip x:Name="SongInfoTooltip" Placement="Top">
                    <ToolTip.Style>
                        <Style TargetType="ToolTip">
                            <Setter Property="Background" Value="#2D2D30"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif"/>
                        </Style>
                    </ToolTip.Style>
                    <StackPanel>
                        <TextBlock x:Name="TooltipTitleText" Text="" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TooltipArtistText" Text="" Foreground="#A0A0A0" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
            <Border.ContextMenu>
                <ContextMenu>
                    <ContextMenu.Resources>
                        <!-- Premium Menu Styles -->
                        <Style TargetType="ContextMenu">
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
                            <Setter Property="HasDropShadow" Value="True" />
                            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif"/>
                            <Setter Property="MinWidth" Value="150"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Name="Border" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="0,4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" Direction="270" Color="Black" Opacity="0.12" ShadowDepth="4" />
                                            </Border.Effect>
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Standard Interactive MenuItem -->
                        <Style TargetType="MenuItem">
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#333333"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border" Background="Transparent" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/> <!-- Icon Width -->
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/> <!-- Shortcut -->
                                                    <ColumnDefinition Width="15"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Icon -->
                                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                
                                                <!-- Header -->
                                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                                
                                                <!-- Checkmark Overlay -->
                                                <TextBlock x:Name="CheckIcon" Grid.Column="2" Text="&#xf00c;" FontFamily="{StaticResource FontAwesome}" FontSize="12" Foreground="#0067C0" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#F2F2F2"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#F0F7FF"/>
                                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                                <!-- Hide default icon if checked? No, keep logic simple. -->
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Full Width Solid Separator -->
                        <Style TargetType="Separator">
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Separator">
                                        <Border Height="1" Background="#E8E8E8" SnapsToDevicePixels="True"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Non-interactive Container (for Media Buttons) -->
                        <Style x:Key="PassiveMenuItemStyle" TargetType="MenuItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border Background="Transparent" Padding="0,4">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>

                    <!-- Media Controls Row -->
                    <MenuItem Style="{StaticResource PassiveMenuItemStyle}">
                        <MenuItem.Header>
                            <StackPanel Margin="8,0">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" ToolTip="上一首" Click="PreviousTrack_Click" Style="{StaticResource MediaButtonStyle}" Content="&#xf048;" Margin="4,0"/>
                                    <Button x:Name="PlayPauseButton" Grid.Column="1" ToolTip="播放" Click="PlayPause_Click" Style="{StaticResource MediaButtonStyle}" Content="&#xf04b;" Margin="4,0"/>
                                    <Button Grid.Column="2" ToolTip="下一首" Click="NextTrack_Click" Style="{StaticResource MediaButtonStyle}" Content="&#xf051;" Margin="4,0"/>
                                </Grid>
                                <TextBlock x:Name="MenuSongInfoText" Text="暂无媒体播放" 
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           FontSize="10" Foreground="#888888" 
                                           TextTrimming="CharacterEllipsis" MaxWidth="170"
                                           Margin="0,5,0,2"/>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    

                    
                    <MenuItem Header="设置" Click="OpenSettings_Click">
                        <MenuItem.Icon>
                           <TextBlock Text="&#xf013;" FontFamily="{StaticResource FontAwesome}" FontSize="14" Foreground="#555555"/> 
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="检查更新..." Click="CheckForUpdates_Click">
                        <MenuItem.Icon>
                           <TextBlock Text="&#xf0ab;" FontFamily="{StaticResource FontAwesome}" FontSize="12" Foreground="#555555"/> 
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="悬浮歌词" IsCheckable="True" Checked="FloatingLyrics_Checked" Unchecked="FloatingLyrics_Unchecked" x:Name="FloatingLyricsMenuItem">
                         <MenuItem.Icon>
                            <TextBlock Text="&#xf24d;" FontFamily="{StaticResource FontAwesome}" FontSize="12" Foreground="#555555"/> 
                         </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="鼠标穿透" IsCheckable="True" Checked="FloatingLyricsCtx_Checked" Unchecked="FloatingLyricsCtx_Unchecked" x:Name="FloatingLyricsCtxItem" Margin="20,0,0,0">
                         <MenuItem.Icon>
                            <TextBlock Text="&#xf245;" FontFamily="{StaticResource FontAwesome}" FontSize="12" Foreground="#555555"/> 
                         </MenuItem.Icon>
                    </MenuItem>
                    
                    <Separator/>
                    
                    <MenuItem Header="重启" Click="Restart_Click">
                        <MenuItem.Icon>
                           <TextBlock Text="&#xf021;" FontFamily="{StaticResource FontAwesome}" FontSize="13" Foreground="#555555"/> 
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="退出" Click="Exit_Click">
                        <MenuItem.Icon>
                           <TextBlock Text="&#xf00d;" FontFamily="{StaticResource FontAwesome}" FontSize="14" Foreground="#FF4D4F"/> 
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Drag Handle -->
                <Border x:Name="DragHandle" Grid.Column="0" Width="12" Height="24"
                        Margin="0,0,4,0" VerticalAlignment="Center" Cursor="SizeAll"
                        Background="Transparent" ToolTip="拖动调整歌词位置"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                    <Border Width="4" Height="14" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=DragHandle}" Value="True">
                                        <Setter Property="Background" Value="#A0FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Border>

                <Image x:Name="AppIcon" Grid.Column="1" Width="24" Height="24" Margin="4,0,8,0" 
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="AppIcon_MouseLeftButtonDown"/>

                <Canvas x:Name="TextContainer" Grid.Column="2" ClipToBounds="True" Height="20" VerticalAlignment="Center">
                    <TextBlock x:Name="InfoText" Text="歌词加载中..." 
                               FontSize="12" FontWeight="SemiBold"
                               Canvas.Left="0" Canvas.Top="2">
                        <TextBlock.Foreground>
                            <LinearGradientBrush x:Name="MainLyricBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="MainLyricStop1" Color="#FF33BBFF" Offset="0"/>
                                <GradientStop x:Name="MainLyricStop2" Color="White" Offset="0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Name="NextLyricText" Text="" 
                               FontSize="11" 
                               Canvas.Left="0" Visibility="Collapsed">
                        <TextBlock.Foreground>
                            <LinearGradientBrush x:Name="NextLyricBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="NextLyricStop1" Color="#FF33BBFF" Offset="0"/>
                                <GradientStop x:Name="NextLyricStop2" Color="White" Offset="0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
