<Window x:Class="TaskbarInfo.TaskbarWaterReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarInfo 喝水助手"
        Width="116"
        Height="30"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False" FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <Window.Resources>
        <FontFamily x:Key="FontAwesome">./Fonts/fa-solid-900.ttf#Font Awesome 6 Free Solid</FontFamily>
        <Style x:Key="WaterReminderMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource ThemeMenuBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeMenuBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0,4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270" Color="Black" Opacity="0.12" ShadowDepth="4" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WaterReminderMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMenuForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,10,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource ThemeMenuHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WaterReminderMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource ThemeMenuSeparatorBrush}" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WaterReminderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="ReminderSurface" Background="#33000000" CornerRadius="5" Padding="2">
        <Button x:Name="ReminderButton"
                Style="{StaticResource WaterReminderButtonStyle}"
                Foreground="#D8FFFFFF"
                ToolTip="记录一次饮水"
                PreviewMouseLeftButtonDown="ReminderButton_PreviewMouseLeftButtonDown"
                PreviewMouseMove="ReminderButton_PreviewMouseMove"
                PreviewMouseLeftButtonUp="ReminderButton_PreviewMouseLeftButtonUp"
                Click="Drink_Click">
            <Button.ContextMenu>
                <ContextMenu Style="{StaticResource WaterReminderMenuStyle}">
                    <MenuItem Header="立即记录" Click="Drink_Click" Style="{StaticResource WaterReminderMenuItemStyle}">
                        <MenuItem.Icon><TextBlock Text="&#xf043;" FontFamily="{StaticResource FontAwesome}" FontSize="13" Foreground="{DynamicResource ThemeMenuIconBrush}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="稍后提醒" Click="Snooze_Click" Style="{StaticResource WaterReminderMenuItemStyle}">
                        <MenuItem.Icon><TextBlock Text="&#xf017;" FontFamily="{StaticResource FontAwesome}" FontSize="13" Foreground="{DynamicResource ThemeMenuIconBrush}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource WaterReminderMenuSeparatorStyle}" />
                    <MenuItem Header="设置" Click="OpenSettings_Click" Style="{StaticResource WaterReminderMenuItemStyle}">
                        <MenuItem.Icon><TextBlock Text="&#xf013;" FontFamily="{StaticResource FontAwesome}" FontSize="14" Foreground="{DynamicResource ThemeMenuIconBrush}" /></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ReminderIcon" Text="&#xf043;" FontFamily="{StaticResource FontAwesome}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="ReminderText" Grid.Column="2" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Border>
</Window>

