<Window x:Class="TaskbarInfo.WaterReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="264"
        Height="148"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        AllowsTransparency="False"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="WaterPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#357FD8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#4C92E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1E68C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WaterSecondaryButton" TargetType="Button" BasedOn="{StaticResource WaterPrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>
    <Border x:Name="RootCard"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TextBlock Text="该喝水了" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Grid.Row="2" Foreground="{DynamicResource ThemeSecondaryTextBrush}" FontSize="12" />
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource WaterSecondaryButton}" Content="稍后" Click="Snooze_Click" />
                <Button Grid.Column="2" Style="{StaticResource WaterPrimaryButton}" Content="喝了" Click="Drink_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
