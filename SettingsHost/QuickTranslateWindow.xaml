<Window
    x:Class="LyricsX.Settings.QuickTranslateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="快捷翻译">
    <Grid x:Name="RootLayout" Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="84" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProviderBox"
                      Grid.Column="0"
                      Width="148"
                      HorizontalAlignment="Left"
                      SelectionChanged="ProviderBox_SelectionChanged" />
            <ComboBox x:Name="TargetLanguageBox"
                      Grid.Column="2"
                      Width="128"
                      SelectedIndex="0"
                      HorizontalAlignment="Right">
                <ComboBoxItem Tag="zh-CN" Content="译为中文" />
                <ComboBoxItem Tag="en" Content="译为英文" />
                <ComboBoxItem Tag="ja" Content="译为日文" />
                <ComboBoxItem Tag="ko" Content="译为韩文" />
            </ComboBox>
            <ToggleButton x:Name="AlwaysOnTopButton"
                    Grid.Column="4"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="置顶窗口"
                    Checked="AlwaysOnTopButton_Checked"
                    Unchecked="AlwaysOnTopButton_Unchecked">
                <SymbolIcon Symbol="Pin" />
            </ToggleButton>
        </Grid>

        <TextBox x:Name="InputTextBox"
                 Grid.Row="2"
                 Header="输入内容"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 PlaceholderText="输入要翻译的文本"
                 VerticalContentAlignment="Top"
                 KeyDown="InputTextBox_KeyDown" />

        <controls:InfoBar x:Name="StatusInfoBar"
                          Grid.Row="4"
                          IsOpen="False"
                          IsClosable="True"
                          Severity="Informational"
                          Visibility="Collapsed" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="译文" VerticalAlignment="Center" />
            <Button x:Name="TranslateButton"
                    Grid.Column="1"
                    MinWidth="76"
                    Content="翻译"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Translate_Click" />
        </Grid>

        <TextBox x:Name="ResultTextBox"
                 Grid.Row="8"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 PlaceholderText="翻译结果将显示在这里"
                 VerticalContentAlignment="Top" />
    </Grid>
</Window>
