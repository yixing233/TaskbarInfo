<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;bin\**;obj\**;publish\**</DefaultItemExcludes>
    <RootNamespace>LyricsX.Settings</RootNamespace>
    <AssemblyName>TaskbarInfo.Settings</AssemblyName>
    <Version>1.1.8</Version>
    <AssemblyVersion>1.1.8.0</AssemblyVersion>
    <FileVersion>1.1.8.0</FileVersion>
    <InformationalVersion>1.1.8</InformationalVersion>
    <RepositoryUrl>https://github.com/yixing233/TaskbarInfo</RepositoryUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\src\icons\LyricsX.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\WindowSizeConstraints.cs" Link="WindowSizeConstraints.cs" />
    <Compile Include="..\TaskbarPerformanceMetrics.cs" Link="TaskbarPerformanceMetrics.cs" />
    <Compile Include="..\TaskbarComponentMonitorSelection.cs" Link="TaskbarComponentMonitorSelection.cs" />
    <Compile Include="..\UpdateService.cs" Link="UpdateService.cs" />
    <Compile Include="..\QuickTranslateLaunchOptions.cs" Link="QuickTranslateLaunchOptions.cs" />
    <Compile Include="..\QuickTranslateLayout.cs" Link="QuickTranslateLayout.cs" />
    <Compile Include="..\QuickTranslateHotkey.cs" Link="QuickTranslateHotkey.cs" />
    <Compile Include="..\QuickTranslateWindowMaterial.cs" Link="QuickTranslateWindowMaterial.cs" />
    <Compile Include="..\ApplicationTheme.cs" Link="ApplicationTheme.cs" />
    <Compile Include="..\QuickTranslateTargetLanguages.cs" Link="QuickTranslateTargetLanguages.cs" />
    <Compile Include="..\SettingsStorage.cs" Link="SettingsStorage.cs" />
    <Compile Include="..\TranslationConfiguration.cs" Link="TranslationConfiguration.cs" />
    <Compile Include="..\TranslationDomainCatalog.cs" Link="TranslationDomainCatalog.cs" />
    <Compile Include="..\TranslationProviderProfile.cs" Link="TranslationProviderProfile.cs" />
    <Compile Include="..\TranslationService.cs" Link="TranslationService.cs" />
    <Compile Include="..\WaterReminderHistory.cs" Link="WaterReminderHistory.cs" />
    <Content Include="..\src\icons\LyricsX.ico" Link="Assets\LyricsX.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
  </ItemGroup>
</Project>
