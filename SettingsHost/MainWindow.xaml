<Window
    x:Class="TinyBar.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="TinyBar 设置">
    <NavigationView x:Name="NavMenu"
                    PaneDisplayMode="Auto"
                    IsPaneOpen="True"
                    IsPaneToggleButtonVisible="True"
                    PaneTitle="TinyBar"
                    OpenPaneLength="224"
                    CompactPaneLength="48"
                    ExpandedModeThresholdWidth="760"
                    CompactModeThresholdWidth="640"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    DisplayModeChanged="NavMenu_DisplayModeChanged"
                    SelectionChanged="NavMenu_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="歌词组件" Tag="Lyrics">
                <NavigationViewItem.Icon><SymbolIcon Symbol="MusicInfo" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="性能监控" Tag="TaskbarPerformance">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="喝水助手" Tag="WaterReminder">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="快捷翻译" Tag="QuickTranslate">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Character" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="通用设置" Tag="GeneralSettings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Grid x:Name="RootLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleDragRegion"
                  Grid.Column="0"
                  Background="Transparent"
                  PointerPressed="TitleDragRegion_PointerPressed" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="46"
                        Height="48"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="最小化"
                        Click="Minimize_Click">
                    <SymbolIcon Symbol="Remove" />
                </Button>
                <Button Width="46"
                        Height="48"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="关闭"
                        Click="Close_Click">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Frame x:Name="ContentFrame" />
                <InfoBar x:Name="ErrorInfoBar"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top"
                         Margin="16,8,16,0"
                         MaxWidth="560"
                         IsOpen="False"
                         Severity="Error"
                         IsClosable="True" />
            </Grid>
        </Grid>
    </NavigationView>
</Window>
