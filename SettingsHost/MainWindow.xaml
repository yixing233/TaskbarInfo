<Window
    x:Class="LyricsX.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="TaskbarInfo 设置">
    <NavigationView x:Name="NavMenu"
                    PaneDisplayMode="Auto"
                    IsPaneOpen="True"
                    IsPaneToggleButtonVisible="True"
                    PaneTitle="TaskbarInfo"
                    OpenPaneLength="224"
                    CompactPaneLength="48"
                    ExpandedModeThresholdWidth="880"
                    CompactModeThresholdWidth="760"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    DisplayModeChanged="NavMenu_DisplayModeChanged"
                    SelectionChanged="NavMenu_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="歌词组件" SelectsOnInvoked="False" IsExpanded="True">
                <NavigationViewItem.Icon><SymbolIcon Symbol="MusicInfo" /></NavigationViewItem.Icon>
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Content="布局与显示" Tag="Typography" />
                    <NavigationViewItem Content="其他效果" Tag="Visual" />
                    <NavigationViewItem Content="悬浮歌词" Tag="Floating" />
                    <NavigationViewItem Content="桌面歌词" Tag="DesktopWidget" />
                    <NavigationViewItem Content="应用筛选" Tag="Applications" />
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>
            <NavigationViewItem Content="性能监控" Tag="TaskbarPerformance">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="喝水助手" Tag="WaterReminder">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="快捷翻译" Tag="QuickTranslate">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Character" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="关于" Tag="About">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Grid x:Name="RootLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleDragRegion"
                  Grid.Column="0"
                  Background="Transparent"
                  PointerPressed="TitleDragRegion_PointerPressed" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="46"
                        Height="48"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="最小化"
                        Click="Minimize_Click">
                    <SymbolIcon Symbol="Remove" />
                </Button>
                <Button Width="46"
                        Height="48"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="关闭"
                        Click="Close_Click">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </StackPanel>
            </Grid>

            <Frame x:Name="ContentFrame" Grid.Row="1" />

            <Grid Grid.Row="2" MinHeight="64" Height="Auto">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
            <Grid Padding="12,8" MinHeight="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <InfoBar x:Name="ErrorInfoBar"
                         Grid.Column="0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         MinWidth="220"
                         MaxWidth="360"
                         MinHeight="40"
                         MaxHeight="48"
                         IsOpen="False"
                         Severity="Error"
                         IsClosable="True" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="取消"
                            MinWidth="64"
                            Height="32"
                            Padding="12,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="Cancel_Click" />
                    <Button Content="应用"
                            MinWidth="68"
                            Height="32"
                            Padding="12,0"
                            Click="Apply_Click" />
                    <Button Content="确认"
                            MinWidth="68"
                            Height="32"
                            Padding="12,0"
                            Click="Confirm_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
