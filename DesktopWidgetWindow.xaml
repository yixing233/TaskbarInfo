<UserControl x:Class="TaskbarInfo.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="148"
        Background="{DynamicResource DesktopWidgetWindowBackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    <UserControl.Resources>
        <FontFamily x:Key="FontAwesome">./Fonts/fa-solid-900.ttf#Font Awesome 6 Free Solid</FontFamily>
        <SolidColorBrush x:Key="DesktopWidgetWindowBackgroundBrush" Color="#FF081025"/>
        <SolidColorBrush x:Key="DesktopWidgetCardBackgroundBrush" Color="#E6081025"/>
        <SolidColorBrush x:Key="DesktopWidgetCardBorderBrush" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="DesktopWidgetPrimaryTextBrush" Color="#F6F8FF"/>
        <SolidColorBrush x:Key="DesktopWidgetSecondaryTextBrush" Color="#78839D"/>
        <SolidColorBrush x:Key="DesktopWidgetTimeTextBrush" Color="#66718A"/>
        <SolidColorBrush x:Key="DesktopWidgetLyricTextBrush" Color="#DEE5F5"/>
        <SolidColorBrush x:Key="DesktopWidgetControlForegroundBrush" Color="#DDE5F7"/>
        <SolidColorBrush x:Key="DesktopWidgetControlHoverBrush" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="DesktopWidgetControlPressedBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="DesktopWidgetProgressTrackBrush" Color="#1B2338"/>
        <SolidColorBrush x:Key="DesktopWidgetAccentBrush" Color="#B778FF"/>
        <Color x:Key="DesktopWidgetAccentColor">#B778FF</Color>

        <Style x:Key="DesktopMediaButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DesktopWidgetControlForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FontAwesome}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource DesktopWidgetControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource DesktopWidgetControlPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesktopProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource DesktopWidgetAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DesktopWidgetProgressTrackBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="False">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource DesktopWidgetAccentColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.75"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesktopWidgetContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource DesktopWidgetCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DesktopWidgetCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#80000000" BlurRadius="14" ShadowDepth="4" Opacity="0.45"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesktopWidgetContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource DesktopWidgetPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           Foreground="{StaticResource DesktopWidgetAccentBrush}"
                                           FontWeight="SemiBold"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource DesktopWidgetControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesktopWidgetContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="7,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource DesktopWidgetCardBorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="WidgetRoot" MouseLeftButtonDown="WidgetRoot_MouseLeftButtonDown"
          MouseMove="WidgetRoot_MouseMove" MouseLeftButtonUp="WidgetRoot_MouseLeftButtonUp">
        <Border x:Name="CardBorder"
                Background="{DynamicResource DesktopWidgetCardBackgroundBrush}"
                BorderBrush="{DynamicResource DesktopWidgetCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle x:Name="AlbumArtRectangle"
                           Grid.Column="0"
                           Width="90" Height="90"
                           RadiusX="10" RadiusY="10"
                           VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#90000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                    </Rectangle.Effect>
                </Rectangle>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TrackTitleText"
                               Grid.Row="0"
                               Text="等待播放"
                               Foreground="{DynamicResource DesktopWidgetPrimaryTextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TrackArtistText"
                               Grid.Row="1"
                               Text="TaskbarInfo"
                               Foreground="{DynamicResource DesktopWidgetSecondaryTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top"/>

                    <Grid x:Name="LyricViewport" Grid.Row="2" Height="48" ClipToBounds="True">
                        <TextBlock x:Name="LyricPrimary"
                                   Text="歌词将在这里显示"
                                   Foreground="{DynamicResource DesktopWidgetLyricTextBrush}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="LyricPrimaryTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="LyricSecondary"
                                   Foreground="{DynamicResource DesktopWidgetLyricTextBrush}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="LyricSecondaryTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <ProgressBar x:Name="PlaybackProgress"
                                 Grid.Row="3"
                                 Minimum="0" Maximum="1" Value="0"
                                 Style="{StaticResource DesktopProgressStyle}"
                                 VerticalAlignment="Center"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button ToolTip="上一首" Content="&#xf048;" Style="{StaticResource DesktopMediaButtonStyle}" Click="PreviousTrack_Click"/>
                            <Button x:Name="PlayPauseButton" ToolTip="播放" Content="&#xf04b;" Style="{StaticResource DesktopMediaButtonStyle}" Click="PlayPause_Click"/>
                            <Button ToolTip="下一首" Content="&#xf051;" Style="{StaticResource DesktopMediaButtonStyle}" Click="NextTrack_Click"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DesktopWidgetTimeTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="9.5">
                            <Run x:Name="ElapsedTimeRun" Text="0:00"/><Run Text=" / "/><Run x:Name="TotalTimeRun" Text="0:00"/>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource DesktopWidgetContextMenuStyle}">
                <MenuItem x:Name="LockPositionMenuItem" Header="锁定位置" IsCheckable="True" Click="LockPosition_Click" Style="{StaticResource DesktopWidgetContextMenuItemStyle}"/>
                <MenuItem Header="桌面组件设置" Click="Settings_Click" Style="{StaticResource DesktopWidgetContextMenuItemStyle}"/>
                <Separator Style="{StaticResource DesktopWidgetContextMenuSeparatorStyle}"/>
                <MenuItem Header="关闭桌面组件" Click="Close_Click" Style="{StaticResource DesktopWidgetContextMenuItemStyle}"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</UserControl>
