<Window x:Class="TaskbarInfo.AppFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用域设置" Height="400" Width="350"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
    
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#202020"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#666666"/>
        <SolidColorBrush x:Key="SystemAccentColor" Color="#0067C0"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#E0E0E0"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FBFBFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SystemAccentColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                        </Border>
                         <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1975C5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1975C5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="选择允许的应用" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryColor}"/>
            <TextBlock Text="仅获取勾选应用的媒体信息。" FontSize="12" Foreground="{StaticResource TextSecondaryColor}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="若要允许所有应用，请清空所有勾选。" FontSize="12" Foreground="#888888" Margin="0,2,0,0" TextWrapping="Wrap"/>
            
            <Separator Margin="0,15,0,15" Background="#E0E0E0"/>
            
            <TextBlock Text="自动化显示" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryColor}"/>
            <CheckBox x:Name="CheckRunOnly" Content="仅在检测到上述选中的应用运行时显示歌词" Margin="0,8,0,0" Foreground="{StaticResource TextPrimaryColor}" VerticalContentAlignment="Center"/>
            <TextBlock Text="若未选中任何应用，此功能将不会生效。" FontSize="11" Foreground="#999999" Margin="22,2,0,0" Visibility="{Binding IsChecked, ElementName=CheckRunOnly, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
            <ListView x:Name="AppList" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="5"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="刷新" Width="60" Click="Refresh_Click"/>
            
            <Button Grid.Column="2" Content="取消" Width="70" Click="Cancel_Click"/>
            <Button Grid.Column="4" Content="确认" Width="70" Style="{StaticResource AccentButton}" Click="Confirm_Click"/>
        </Grid>
    </Grid>
</Window>
